{
  "name": "digital-banking",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/** run build && pnpm -r --filter=./apps/** run build",
    "dev:api-gateway": "pnpm --filter api-gateway run start:dev",
    "dev:identity-service": "pnpm --filter identity-service run start:dev",
    "dev:customer-service": "pnpm --filter customer-service run start:dev",
    "dev:kyc-service": "pnpm --filter kyc-service run start:dev",
    "dev:account-service": "pnpm --filter account-service run start:dev",
    "dev:ledger-service": "pnpm --filter ledger-service run start:dev",
    "dev:fraud-service": "pnpm --filter fraud-service run start:dev",
    "dev:transfer-service": "pnpm --filter transfer-service run start:dev",
    "dev:notification-service": "pnpm --filter notification-service run start:dev",
    "dev:payment-service": "pnpm --filter payment-service run start:dev",
    "dev:card-service": "pnpm --filter card-service run start:dev",
    "dev:reporting-service": "pnpm --filter reporting-service run start:dev",
    "dev:customer-portal": "pnpm --filter customer-portal run start",
    "dev": "concurrently -n identity,customer,kyc,account,ledger,fraud,transfer,notification,payment,card,reporting,gateway -c blue,cyan,green,yellow,magenta,red,blue,cyan,green,yellow,magenta,red \"pnpm:dev:identity-service\" \"pnpm:dev:customer-service\" \"pnpm:dev:kyc-service\" \"pnpm:dev:account-service\" \"pnpm:dev:ledger-service\" \"pnpm:dev:fraud-service\" \"pnpm:dev:transfer-service\" \"pnpm:dev:notification-service\" \"pnpm:dev:payment-service\" \"pnpm:dev:card-service\" \"pnpm:dev:reporting-service\" \"pnpm:dev:api-gateway\"",
    "dev:all": "concurrently -n backend,frontend -c blue,green \"pnpm:dev\" \"pnpm:dev:customer-portal\"",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "infra:up": "docker compose -f infrastructure/docker/docker-compose.yml up -d",
    "infra:down": "docker compose -f infrastructure/docker/docker-compose.yml down",
    "infra:logs": "docker compose -f infrastructure/docker/docker-compose.yml logs -f",
    "prisma:identity:generate": "pnpm --filter identity-service exec prisma generate",
    "prisma:identity:migrate": "pnpm --filter identity-service exec prisma migrate dev",
    "prisma:customer:generate": "pnpm --filter customer-service exec prisma generate",
    "prisma:customer:migrate": "pnpm --filter customer-service exec prisma migrate dev",
    "prisma:kyc:generate": "pnpm --filter kyc-service exec prisma generate",
    "prisma:kyc:migrate": "pnpm --filter kyc-service exec prisma migrate dev",
    "prisma:account:generate": "pnpm --filter account-service exec prisma generate",
    "prisma:account:migrate": "pnpm --filter account-service exec prisma migrate dev",
    "prisma:ledger:generate": "pnpm --filter ledger-service exec prisma generate",
    "prisma:ledger:migrate": "pnpm --filter ledger-service exec prisma migrate dev",
    "prisma:fraud:generate": "pnpm --filter fraud-service exec prisma generate",
    "prisma:fraud:migrate": "pnpm --filter fraud-service exec prisma migrate dev",
    "prisma:transfer:generate": "pnpm --filter transfer-service exec prisma generate",
    "prisma:transfer:migrate": "pnpm --filter transfer-service exec prisma migrate dev",
    "prisma:notification:generate": "pnpm --filter notification-service exec prisma generate",
    "prisma:notification:migrate": "pnpm --filter notification-service exec prisma migrate dev",
    "prisma:payment:generate": "pnpm --filter payment-service exec prisma generate",
    "prisma:payment:migrate": "pnpm --filter payment-service exec prisma migrate dev",
    "prisma:card:generate": "pnpm --filter card-service exec prisma generate",
    "prisma:card:migrate": "pnpm --filter card-service exec prisma migrate dev",
    "prisma:reporting:generate": "pnpm --filter reporting-service exec prisma generate",
    "prisma:reporting:migrate": "pnpm --filter reporting-service exec prisma migrate dev"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
