# Shared local development environment variables.
# Copy to .env and adjust as needed. Never commit the real .env file.

NODE_ENV=development

# Postgres
# NOTE: mapped to host port 5433 (not 5432) to avoid clashing with a
# locally-installed Postgres you may already be running.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=banking
POSTGRES_PASSWORD=banking
IDENTITY_DATABASE_URL=postgresql://banking:banking@localhost:5433/identity_db?schema=public
CUSTOMER_DATABASE_URL=postgresql://banking:banking@localhost:5433/customer_db?schema=public
KYC_DATABASE_URL=postgresql://banking:banking@localhost:5433/kyc_db?schema=public
ACCOUNT_DATABASE_URL=postgresql://banking:banking@localhost:5433/account_db?schema=public
LEDGER_DATABASE_URL=postgresql://banking:banking@localhost:5433/ledger_db?schema=public
FRAUD_DATABASE_URL=postgresql://banking:banking@localhost:5433/fraud_db?schema=public
TRANSFER_DATABASE_URL=postgresql://banking:banking@localhost:5433/transfer_db?schema=public
NOTIFICATION_DATABASE_URL=postgresql://banking:banking@localhost:5433/notification_db?schema=public
PAYMENT_DATABASE_URL=postgresql://banking:banking@localhost:5433/payment_db?schema=public
CARD_DATABASE_URL=postgresql://banking:banking@localhost:5433/card_db?schema=public
REPORTING_DATABASE_URL=postgresql://banking:banking@localhost:5433/reporting_db?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=digital-banking

# Auth
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Services
API_GATEWAY_PORT=3000
# Comma-separated list of browser origins allowed to call the gateway (e.g. the customer-portal dev server)
CORS_ORIGINS=http://localhost:4200
IDENTITY_SERVICE_PORT=3001
IDENTITY_SERVICE_URL=http://localhost:3001
CUSTOMER_SERVICE_PORT=3002
CUSTOMER_SERVICE_URL=http://localhost:3002
KYC_SERVICE_PORT=3003
KYC_SERVICE_URL=http://localhost:3003
ACCOUNT_SERVICE_PORT=3004
ACCOUNT_SERVICE_URL=http://localhost:3004
LEDGER_SERVICE_PORT=3005
LEDGER_SERVICE_URL=http://localhost:3005
FRAUD_SERVICE_PORT=3006
FRAUD_SERVICE_URL=http://localhost:3006
TRANSFER_SERVICE_PORT=3007
TRANSFER_SERVICE_URL=http://localhost:3007
NOTIFICATION_SERVICE_PORT=3008
NOTIFICATION_SERVICE_URL=http://localhost:3008
PAYMENT_SERVICE_PORT=3009
PAYMENT_SERVICE_URL=http://localhost:3009
CARD_SERVICE_PORT=3010
CARD_SERVICE_URL=http://localhost:3010
REPORTING_SERVICE_PORT=3011
REPORTING_SERVICE_URL=http://localhost:3011

# Daily aggregate transfer limit per customer, in minor units (cents).
DAILY_TRANSFER_LIMIT=1000000
