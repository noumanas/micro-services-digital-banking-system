generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("ACCOUNT_DATABASE_URL")
}

model Account {
  id         String   @id @default(uuid())
  tenantId   String
  customerId String
  type       String // CURRENT | SAVINGS | BUSINESS | WALLET
  currency   String
  status     String   @default("PENDING_ACTIVATION") // PENDING_ACTIVATION | ACTIVE | FROZEN | CLOSED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId, customerId])
  @@map("accounts")
}

// Local, eventually-consistent read-model populated by consuming
// kyc-service's KycApproved/KycRejected events (PRD section 17 event
// catalog: "KycApproved | KYC | Customer, Account" — both consume it
// independently). Account creation is gated on this, never on a live
// cross-service call to customer-service or kyc-service.
model CustomerKycStatus {
  tenantId   String
  customerId String
  approved   Boolean
  updatedAt  DateTime @updatedAt

  @@id([tenantId, customerId])
  @@map("customer_kyc_status")
}

model OutboxEvent {
  id          String    @id @default(uuid())
  tenantId    String
  eventType   String
  payload     Json
  published   Boolean   @default(false)
  publishedAt DateTime?
  attempts    Int       @default(0)
  lastError   String?
  createdAt   DateTime  @default(now())

  @@index([published, createdAt])
  @@map("outbox_events")
}

model AuditLog {
  id            String   @id @default(uuid())
  tenantId      String
  actorUserId   String?
  action        String
  resource      String
  result        String
  correlationId String
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

model DeadLetter {
  id           String   @id @default(uuid())
  consumerName String
  topic        String
  eventId      String?
  eventType    String?
  payload      Json?
  rawValue     String
  errorMessage String
  retryCount   Int
  createdAt    DateTime @default(now())

  @@map("dead_letters")
}
