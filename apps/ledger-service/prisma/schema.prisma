generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("LEDGER_DATABASE_URL")
}

// The financial source of truth (PRD section 10). One row per real,
// customer-facing account (mirrored from account-service via AccountCreated,
// keyed by externalAccountId — never a live cross-service call), plus a
// handful of internal system accounts (externalAccountId null, identified by
// `code`) used as the contra side of money entering/leaving the bank.
model LedgerAccount {
  id                String   @id @default(uuid())
  tenantId          String
  externalAccountId String? // account-service's Account.id; null for system accounts
  customerId        String? // owner, for self-scoping; null for system accounts
  code              String? // e.g. "EXTERNAL_FUNDING"; null for customer accounts
  currency          String
  createdAt         DateTime @default(now())

  lines JournalLine[]

  @@unique([externalAccountId])
  @@unique([tenantId, code, currency])
  @@index([tenantId, customerId])
  @@map("ledger_accounts")
}

// A single business transaction. Immutable once created — corrections are
// modeled as a new JournalEntry via `reversalOf`, never an edit (PRD
// section 10, section 45 principle 2).
model JournalEntry {
  id            String   @id @default(uuid())
  tenantId      String
  reference     String // "DEPOSIT" | "REVERSAL"
  description   String?
  correlationId String
  reversalOfId  String?       @unique
  reversalOf    JournalEntry? @relation("Reversal", fields: [reversalOfId], references: [id])
  reversedBy    JournalEntry? @relation("Reversal")
  createdAt     DateTime      @default(now())

  lines JournalLine[]

  @@index([tenantId, createdAt])
  @@map("journal_entries")
}

// Every line is a positive debit or credit against one ledger account.
// A JournalEntry's lines must always sum to zero (debits == credits) —
// enforced in application code, never edited after the fact.
model JournalLine {
  id             String   @id @default(uuid())
  journalEntryId String
  ledgerAccountId String
  direction      String // DEBIT | CREDIT
  amount         Int // minor units (cents); always positive
  currency       String
  createdAt      DateTime @default(now())

  journalEntry  JournalEntry  @relation(fields: [journalEntryId], references: [id])
  ledgerAccount LedgerAccount @relation(fields: [ledgerAccountId], references: [id])

  @@index([ledgerAccountId, createdAt])
  @@map("journal_lines")
}

model OutboxEvent {
  id          String    @id @default(uuid())
  tenantId    String
  eventType   String
  payload     Json
  published   Boolean   @default(false)
  publishedAt DateTime?
  attempts    Int       @default(0)
  lastError   String?
  createdAt   DateTime  @default(now())

  @@index([published, createdAt])
  @@map("outbox_events")
}

model AuditLog {
  id            String   @id @default(uuid())
  tenantId      String
  actorUserId   String?
  action        String
  resource      String
  result        String
  correlationId String
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

model DeadLetter {
  id           String   @id @default(uuid())
  consumerName String
  topic        String
  eventId      String?
  eventType    String?
  payload      Json?
  rawValue     String
  errorMessage String
  retryCount   Int
  createdAt    DateTime @default(now())

  @@map("dead_letters")
}
